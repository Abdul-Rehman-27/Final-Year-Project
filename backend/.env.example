# Copy to .env and edit
DATABASE_URL=postgresql+psycopg2://cityhospital:cityhospital@localhost:5434/cityhospital
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173
# Medical Assistant integration (chat requests and usage are recorded in this backend database)
MEDICAL_ASSISTANT_URL=http://localhost:8010
MEDICAL_ASSISTANT_API_KEY=
# The Medical Assistant service can share this PostgreSQL database.
MEDICAL_ASSISTANT_DATABASE_URL=postgresql+psycopg2://cityhospital:cityhospital@localhost:5434/cityhospital
# Keep model-provider secrets on the backend; never add them to frontend env files.
GROQ_API_KEY=
# Optional Groq monthly allowance. Leave 0 until a real quota is configured.
GROQ_MONTHLY_TOKEN_LIMIT=0
# Used by scripts/seed.py
SEED_ADMIN_EMAIL=admin@cityhospital.pk
SEED_ADMIN_PASSWORD=Admin@12345
