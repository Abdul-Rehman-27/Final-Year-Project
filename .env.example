# Docker Hub image namespace and lowercase GitHub repository name.
# Set these to pull the images published by the repository maintainer.
DOCKERHUB_USERNAME=local
DOCKERHUB_REPOSITORY=cityhospital
IMAGE_TAG=latest
POSTGRES_HOST_PORT=5434
# Select the default Medical Assistant Ollama model (gemma3:4b or gemma2:9b).
OLLAMA_MODEL=gemma3:4b
