# Optional settings for docker compose (copy to .env). Secrets belong in backend/.env.
POSTGRES_HOST_PORT=5434
# Local fallback model name (Ollama must be running on the host machine).
OLLAMA_MODEL=gemma3:4b
# Only change these if you open the app from another computer, then rebuild: docker compose up --build
