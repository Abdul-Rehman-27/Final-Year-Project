# The GroqCloud key is configured in the existing backend/.env file.
GROQ_MODEL=openai/gpt-oss-120b
OLLAMA_BASE_URL=http://localhost:11434
# Optional. Leave blank to select the first model reported by Ollama.
OLLAMA_MODEL=
# Optional PostgreSQL URL for a shared application database; blank uses SQLite.
MEDICAL_ASSISTANT_DATABASE_URL=
MEDICAL_ASSISTANT_DB=../data.sqlite3
# In production use comma-separated entries: key=scope|scope
MEDICAL_ASSISTANT_API_KEYS=
MEDICAL_ASSISTANT_CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174,http://localhost:8000,http://127.0.0.1:8000
MAX_UPLOAD_MB=15
MAX_MESSAGE_CHARS=5000
